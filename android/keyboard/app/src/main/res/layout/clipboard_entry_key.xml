<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-only
    OpenWhispr: clip card = content on top, a small footer with when it was copied and a pin mark.
-->
<!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
     We just need to ignore the system's audio and haptic feedback settings. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false"
        android:orientation="vertical">

    <ImageView
        android:id="@+id/clipboard_entry_image_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:adjustViewBounds="true"
        android:maxHeight="96dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/clipboard_entry_text_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="3"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/clipboard_entry_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"/>

        <ImageView
            android:id="@+id/clipboard_entry_pinned_icon"
            android:contentDescription="@string/clipboard_history_pinned_first"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

</LinearLayout>
